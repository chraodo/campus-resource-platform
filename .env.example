# Copy to .env for local Compose use. Replace the development-only values.
POSTGRES_PASSWORD=campus-local-dev-only
APP_SECRET=local-development-only-change-me
APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
APP_PORT=8000
SEED_DEMO_DATA=true

APPROVAL_TIMEOUT_HOURS=24
WORK_ORDER_SLA_HOURS=24
CHECKIN_LATE_MINUTES=15
CHECKIN_REMINDER_MINUTES=10

# Leave blank to keep notifications in-app only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
EMAIL_MAX_ATTEMPTS=5
